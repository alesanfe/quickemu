# Fish completion for quickemu — install to ~/.config/fish/completions/
complete -c quickemu -l vm -r -F -d 'VM config file'
complete -c quickemu -l display -x -a 'gtk sdl spice spice-app cocoa vnc none'
complete -c quickemu -l snapshot -x -a 'apply create delete info list'
complete -c quickemu -l monitor -x -a 'socket telnet none'
complete -c quickemu -l serial -x -a 'socket telnet none'
complete -c quickemu -l usb-controller -x -a 'ehci xhci none'
complete -c quickemu -l clone -r -d 'Clone VM to new name'
complete -c quickemu -l full -d 'With --clone, copy disk fully'
complete -c quickemu -l disk-resize -r -d 'Resize VM disk'
complete -c quickemu -l disk-compact -d 'Reclaim disk space'
complete -c quickemu -l export -r -F -d 'Export VM archive'
complete -c quickemu -l import -r -F -d 'Import VM archive'
complete -c quickemu -l rename -r -d 'Rename VM'
complete -c quickemu -l pause -d 'Pause VM'
complete -c quickemu -l resume -d 'Resume VM'
complete -c quickemu -l kill -d 'Kill VM'
complete -c quickemu -l status -d 'VM status'
complete -c quickemu -l screenshot -r -F -d 'Save screenshot'
complete -c quickemu -l send-keys -r -d 'Send keys via monitor'
complete -c quickemu -l type -r -d 'Type text via monitor'
complete -c quickemu -l list-vms -d 'List VMs in directory'
complete -c quickemu -l doctor -d 'Check VM vs host'
complete -c quickemu -l autostart -d 'Create systemd user unit'
complete -c quickemu -l usb-passthrough -r -d 'USB vid:pid'
complete -c quickemu -l dry-run -d 'Print QEMU command only'
complete -c quickemu -l offline -d 'Start VM offline'
complete -c quickemu -l shortcut -d 'Create desktop shortcut'
complete -c quickemu -l status-quo -d 'Do not commit disk changes'
complete -c quickemu -l monitor-cmd -r -d 'Send monitor command'
complete -c quickemu -l version -d 'Show version'
complete -c quickemu -l help -d 'Show help'
