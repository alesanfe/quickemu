# Built Go binaries land in bin/ (entries) — never commit them
/bin/*
!/bin/README.md

# Local test/dev artifacts
/nul
/quickreport.txt
/*.quickvm.tar.gz

# Debian build output (source lives in packaging/debian/)
/debian/
quickreport.json
quickreport.txt

# Built tool binaries land beside sources — never commit them.
# Full-name binaries (dir-name builds, `go run ./tools/dev build`):
tools/*/quickemu-*
tools/*/quickget*
tools/*/quickreport
tools/*/quickgetc
tools/*/qespec
tools/*/qelib
tools/*/dev
# Stray short-name binaries from `go build` inside module dirs:
tools/*/api
tools/*/archive
tools/*/catalog
tools/*/cli
tools/*/launch
tools/*/ops
tools/*/ports
tools/*/proc
tools/*/qmp
tools/*/toml
tools/*/vm

# Go coverage artifacts (CI uploads them, never commit)
tools/*/coverage.out
