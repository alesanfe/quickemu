{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://quickemu.dev/schemas/v1/vm-toml.schema.json",
 "title": "Quickemu TOML VM config (formatVersion 1)",
 "type": "object",
 "description": "Declarative VM configuration parsed by toml_parse/vm_config_load. Keys are flat; unknown keys are rejected by toml_validate. All values are TOML strings unless noted.",
 "properties": {
  "formatVersion": {"type": "integer", "const": 1},
  "guest_os": {"type": "string", "pattern": "^[a-z0-9-]+$"},
  "arch": {"type": "string", "enum": ["x86_64", "aarch64"]},
  "disk_img": {"type": "string"},
  "disk_format": {"type": "string", "enum": ["qcow2", "raw"]},
  "disk_size": {"type": "string", "pattern": "^[0-9]+[KMGT]?$"},
  "iso": {"type": "string"},
  "img": {"type": "string"},
  "ram": {"type": "string", "pattern": "^[0-9]+[MG]$"},
  "cpu_cores": {"type": "string"},
  "network": {"type": "string"},
  "bridge": {"type": "string"},
  "macaddr": {"type": "string"},
  "ssh_port": {"type": "string"},
  "spice_port": {"type": "string"},
  "display": {"type": "string", "enum": ["sdl", "gtk", "none", "spice", "spice-app", "vnc"]},
  "monitor": {"type": "string", "enum": ["socket", "telnet", "none"]},
  "serial": {"type": "string"},
  "sound_card": {"type": "string"},
  "sound_duplex": {"type": "string"},
  "public_dir": {"type": "string"},
  "seed": {"type": "string"},
  "kernel": {"type": "string"},
  "initrd": {"type": "string"},
  "boot_args": {"type": "string"},
  "boot": {"type": "string"},
  "tpm": {"type": "string"},
  "secureboot": {"type": "string"},
  "gl": {"type": "string"},
  "width": {"type": "string", "pattern": "^[0-9]+$"},
  "height": {"type": "string", "pattern": "^[0-9]+$"},
  "vnc_listen": {"type": "string"},
  "monitor_cmd": {"type": "string"},
  "port_forwards": {"type": "string"},
  "gpu_passthrough": {"type": "string"},
  "viewer": {"type": "string"},
  "extra_disks": {"type": "string"},
  "extra_nics": {"type": "string"},
  "extra_macs": {"type": "string"}
 },
 "additionalProperties": false
}
