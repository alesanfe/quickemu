#!/usr/bin/env bash
export LC_ALL=C

if ((BASH_VERSINFO[0] < 4)); then
    echo "Sorry, you need bash 4.0 or newer to run this script."
    exit 1
fi

### MAIN

# Lowercase variables are used in the VM config file only
boot="efi"
cpu_cores=""
disk_format="${disk_format:-qcow2}"
disk_img="${disk_img:-}"
disk_size="${disk_size:-16G}"
display="${display:-gtk}"
extra_args="${extra_args:-}"
fixed_iso=""
floppy=""
guest_os="linux"
img=""
iso=""
macaddr=""
macos_release=""
network=""
port_forwards=()
preallocation="off"
ram=""
secureboot="off"
tpm="off"
usb_devices=()
gpu_passthrough="${gpu_passthrough:-}"
viewer="${viewer:-spicy}"
viewer_extra_args="${viewer_extra_args:-}"
width="${width:-}"
height="${height:-}"
ssh_port="${ssh_port:-}"
spice_port="${spice_port:-}"
monitor="${monitor:-socket}"
kernel="${kernel:-}"
initrd="${initrd:-}"
boot_args="${boot_args:-}"
seed="${seed:-}"
vnc_listen="${vnc_listen:-127.0.0.1:0}"
monitor_telnet_port="${monitor_telnet_port:-4440}"
monitor_telnet_host="${monitor_telnet_host:-localhost}"
# Serial default is set later based on guest_os (after config is sourced)
serial="${serial:-}"
serial_telnet_port="${serial_telnet_port:-6660}"
serial_telnet_host="${serial_telnet_host:-localhost}"
# options: ehci (USB2.0), xhci (USB3.0)
usb_controller="${usb_controller:-ehci}"
keyboard="${keyboard:-usb}"
keyboard_layout="${keyboard_layout:-en-us}"
mouse="${mouse:-tablet}"
sound_card="${sound_card:-}"
sound_duplex="${sound_duplex:-hda-micro}"

ACCESS=""
ACTIONS=()
BRAILLE=""
IGNORE_TSC_WARNING=""
CPU_PINNING=""
FULLSCREEN=""
OUTPUT_FORMAT="human"
CLONE_FULL=""
DISK_SIZE_ARG=""
DRY_RUN=""
EXPORT_FILE=""
IMPORT_FILE=""
MONITOR_CMD=""
RENAME_TO=""
SCREENSHOT_OUT=""
CLONE_NAME=""
SEND_KEYS_ARG=""
TYPE_TEXT=""
PUBLIC=""
PUBLIC_PERMS=""
PUBLIC_TAG=""
VIRTIOFSD=""
VIRTIOFSD_PID=""
VIRTIOFSD_SOCKET=""
SHORTCUT_OPTIONS=""
SNAPSHOT_ACTION=""
SNAPSHOT_TAG=""
SOCKET_MONITOR=""
SOCKET_SERIAL=""
SSH_ACCESS=""
STATUS_QUO=""
USB_PASSTHROUGH=""
VM=""
VMDIR=""
VMNAME=""
VMPATH=""

# CPU flag tracking map for deduplication and conflict detection
declare -A CPU_FLAG_MAP

# shellcheck disable=SC2155
readonly LAUNCHER=$(basename "${0}")
readonly DISK_MIN_SIZE=$((197632 * 8))
readonly VERSION="4.9.9"

# Library modules (progressive modularisation — see lib/).
# bin/../lib/quickemu resolves identically in the source tree and when
# installed as /usr/bin/quickemu -> /usr/lib/quickemu.
QE_LIBDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/quickemu" 2>/dev/null && pwd)"
if [ -d "${QE_LIBDIR}" ]; then
    # support: leaf utilities
    # shellcheck source=lib/quickemu/support/json.sh
    source "${QE_LIBDIR}/support/json.sh"
    # shellcheck source=lib/quickemu/support/process.sh
    source "${QE_LIBDIR}/support/process.sh"
    # shellcheck source=lib/quickemu/support/validation.sh
    source "${QE_LIBDIR}/support/validation.sh"
    # shellcheck source=lib/quickemu/support/filesystem.sh
    source "${QE_LIBDIR}/support/filesystem.sh"
    # host: machine facts
    # shellcheck source=lib/quickemu/host/capabilities.sh
    source "${QE_LIBDIR}/host/capabilities.sh"
    # shellcheck source=lib/quickemu/host/architecture.sh
    source "${QE_LIBDIR}/host/architecture.sh"
    # shellcheck source=lib/quickemu/host/cpu.sh
    source "${QE_LIBDIR}/host/cpu.sh"
    # shellcheck source=lib/quickemu/host/memory.sh
    source "${QE_LIBDIR}/host/memory.sh"
    # shellcheck source=lib/quickemu/host/kvm.sh
    source "${QE_LIBDIR}/host/kvm.sh"
    # shellcheck source=lib/quickemu/host/display.sh
    source "${QE_LIBDIR}/host/display.sh"
    # config: text -> model
    # shellcheck source=lib/quickemu/config/loader.sh
    source "${QE_LIBDIR}/config/loader.sh"
    # shellcheck source=lib/quickemu/config/normalizer.sh
    source "${QE_LIBDIR}/config/normalizer.sh"
    # planning: gates before execution
    # shellcheck source=lib/quickemu/planning/builder.sh
    source "${QE_LIBDIR}/planning/builder.sh"
    # shellcheck source=lib/quickemu/planning/delete-plan.sh
    source "${QE_LIBDIR}/planning/delete-plan.sh"
    # shellcheck source=lib/quickemu/planning/doctor.sh
    source "${QE_LIBDIR}/planning/doctor.sh"
    # runtime: execution
    # shellcheck source=lib/quickemu/runtime/monitor.sh
    source "${QE_LIBDIR}/runtime/monitor.sh"
    # shellcheck source=lib/quickemu/runtime/pid.sh
    source "${QE_LIBDIR}/runtime/pid.sh"
    # shellcheck source=lib/quickemu/runtime/ports.sh
    source "${QE_LIBDIR}/runtime/ports.sh"
    # shellcheck source=lib/quickemu/runtime/daemons.sh
    source "${QE_LIBDIR}/runtime/daemons.sh"
    # shellcheck source=lib/quickemu/runtime/spawn.sh
    source "${QE_LIBDIR}/runtime/spawn.sh"
    # shellcheck source=lib/quickemu/runtime/command-builder.sh
    source "${QE_LIBDIR}/runtime/command-builder.sh"
    # catalog: OS knowledge
    # shellcheck source=lib/quickemu/catalog/resolver.sh
    source "${QE_LIBDIR}/catalog/resolver.sh"
    # shellcheck source=lib/quickemu/catalog/validator.sh
    source "${QE_LIBDIR}/catalog/validator.sh"
    # vm: domain operations
    # shellcheck source=lib/quickemu/vm/identity.sh
    source "${QE_LIBDIR}/vm/identity.sh"
    # shellcheck source=lib/quickemu/vm/lifecycle.sh
    source "${QE_LIBDIR}/vm/lifecycle.sh"
    # shellcheck source=lib/quickemu/vm/snapshots.sh
    source "${QE_LIBDIR}/vm/snapshots.sh"
    # shellcheck source=lib/quickemu/vm/disk.sh
    source "${QE_LIBDIR}/vm/disk.sh"
    # shellcheck source=lib/quickemu/vm/firmware.sh
    source "${QE_LIBDIR}/vm/firmware.sh"
    # shellcheck source=lib/quickemu/vm/boot.sh
    source "${QE_LIBDIR}/vm/boot.sh"
    # cli: user boundary
    # shellcheck source=lib/quickemu/cli/exit-codes.sh
    source "${QE_LIBDIR}/cli/exit-codes.sh"
    # shellcheck source=lib/quickemu/cli/args.sh
    source "${QE_LIBDIR}/cli/args.sh"
    # shellcheck source=lib/quickemu/cli/usage.sh
    source "${QE_LIBDIR}/cli/usage.sh"
    # shellcheck source=lib/quickemu/cli/param-checks.sh
    source "${QE_LIBDIR}/cli/param-checks.sh"
    # shellcheck source=lib/quickemu/cli/status.sh
    source "${QE_LIBDIR}/cli/status.sh"
else
    echo "ERROR! quickemu lib/ directory not found."
    exit 1
fi

ARCH_HOST=$(uname -m)
QEMU_IMG=$(command -v qemu-img)
if [ ! -x "${QEMU_IMG}" ]; then
    echo "ERROR! qemu-img not found. Please make sure qemu-img is installed."
    exit 1
fi

# Check for gnu tools on macOS
STAT="stat"
if command -v gstat &>/dev/null; then
    STAT="gstat"
fi

OS_KERNEL=$(uname -s)
if [ "${OS_KERNEL}" == "Darwin" ]; then
    display="cocoa"
fi

QEMU_VER_LONG=$(${QEMU_IMG} --version | head -n 1 | awk '{print $3}')
# strip patch version and remove dots. 6.0.0 => 60 / 10.0.0 => 100

QEMU_VER_SHORT="${QEMU_VER_LONG%.*}"
QEMU_VER_SHORT="${QEMU_VER_SHORT/./}"

if [ "${QEMU_VER_SHORT}" -lt 61 ]; then
    echo "ERROR! QEMU 6.1.0 or newer is required, detected ${QEMU_VER_LONG}."
    exit 1
fi

cli_parse_args "${@}"

# Actions that do not require a VM configuration run early so they work
# from any directory and without --vm.
for ACTION in "${ACTIONS[@]}"; do
    case "${ACTION}" in
    capabilities | list_vms)
        ${ACTION}
        exit 0
        ;;
    esac
done

if [ -n "${VM}" ] && [ -e "${VM}" ]; then
    # shellcheck source=/dev/null
    source "${VM}"
    PUBLIC="${public_dir:-${PUBLIC}}"

    # Re-detect architecture and QEMU binary after sourcing config
    # Config file can set arch="aarch64" to override the default
    ARCH_VM="${arch:-x86_64}"
    QEMU=$(command -v "qemu-system-${ARCH_VM}")
    if [ ! -x "${QEMU}" ]; then
        echo "ERROR! qemu-system-${ARCH_VM} not found."
        echo "       Please install QEMU for ${ARCH_VM} architecture."
        exit 1
    fi

    vm_identify "${VM}"

    # Set serial default based on guest_os if not explicitly configured.
    # macOS and Windows guests don't output anything useful to serial by default,
    # so disable it to reduce clutter. Users can still override with --serial.
    if [ -z "${serial}" ]; then
        case "${guest_os}" in
        macos | windows | windows-server)
            serial="none"
            ;;
        *)
            serial="socket"
            ;;
        esac
    fi

    # if disk_img is not configured, do the right thing.
    if [ -z "${disk_img}" ]; then
        disk_img="${VMDIR}/disk.${disk_format}"
    fi

    # Fixes running VMs when PWD is not relative to the VM directory
    # https://github.com/quickemu-project/quickemu/pull/875
    if [ ! -f "${disk_img}" ]; then
        pushd "${VMPATH}" >/dev/null || exit
    fi

    # Check if VM is already running
    VM_PID=""
    if [ -r "${VMDIR}/${VMNAME}.pid" ]; then
        VM_PID=$(head -n 1 "${VMDIR}/${VMNAME}.pid")
        if ! vm_pid_alive "${VMDIR}/${VMNAME}.pid"; then
            #VM is not running, cleaning up.
            VM_PID=""
            rm -f "${VMDIR}/${VMNAME}.pid"
            rm -f "${VMDIR}/${VMNAME}.spice"
            rm -f "${VMDIR}/${VMNAME}.sock"
        fi
    fi

    # Iterate over any actions and exit.
    if [ ${#ACTIONS[@]} -ge 1 ]; then
        for ACTION in "${ACTIONS[@]}"; do
            ${ACTION}
        done
        exit
    fi

    if [ -n "${SNAPSHOT_ACTION}" ]; then
        case ${SNAPSHOT_ACTION} in
        apply)
            snapshot_apply "${SNAPSHOT_TAG}"
            snapshot_info
            exit
            ;;
        create)
            snapshot_create "${SNAPSHOT_TAG}"
            snapshot_info
            exit
            ;;
        delete)
            snapshot_delete "${SNAPSHOT_TAG}"
            snapshot_info
            exit
            ;;
        info | list)
            echo "Snapshot information ${disk_img}"
            snapshot_info
            exit
            ;;
        *)
            echo "ERROR! \"${SNAPSHOT_ACTION}\" is not a supported snapshot action."
            usage
            exit 1
            ;;
        esac
    fi
else
    echo "ERROR! Virtual machine configuration not found."
    usage
    exit 1
fi

display_param_check
ports_param_check
sound_card_param_check
tpm_param_check
viewer_param_check
fileshare_param_check

if [ -z "${VM_PID}" ]; then
    vm_boot
    start_viewer
    # If the VM being started is an uninstalled Windows VM then auto-skip the press-any key prompt.
    if [ -n "${iso}" ] && [[ "${guest_os}" == "windows"* ]]; then
        # shellcheck disable=SC2034
        for LOOP in {1..5}; do
            sleep 1
            monitor_send_cmd "sendkey ret"
        done
    fi
else
    echo "${VMNAME}"
    echo " - Process:  Already running ${VM} as ${VMNAME} (${VM_PID})"
    parse_ports_from_file
    # Auto-detect SPICE if .spice file exists and display is a default GUI type
    if [ -r "${VMDIR}/${VMNAME}.spice" ]; then
        if [ "${display}" == "sdl" ] || [ "${display}" == "cocoa" ] || [ "${display}" == "gtk" ]; then
            display="spice"
            spice_port=$(cat "${VMDIR}/${VMNAME}.spice")
        fi
    fi
    start_viewer
fi

if [ -n "${MONITOR_CMD}" ]; then
    monitor_send_cmd "${MONITOR_CMD}"
fi

# vim:tabstop=4:shiftwidth=4:expandtab
