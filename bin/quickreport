#!/usr/bin/env bash
# quickreport — entry point for the Go backend (tools/quickreport plus its
# sibling tools). Resolves packaged installs (libexec/quickemu) and
# dev trees (tools/*/) alike; exposes the tool dir on PATH.
export LC_ALL=C

if ((BASH_VERSINFO[0] < 4)); then
  echo "Sorry, you need bash 4.0 or newer to run this script."
  exit 1
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${HERE}/.." && pwd)"

# Packaged layout: <prefix>/libexec/quickemu/<tool>
# Dev layout:      <repo>/tools/<tool>/<tool>
GO_CLI="${ROOT}/libexec/quickemu/quickreport"
TOOL_DIR="${ROOT}/libexec/quickemu"
if [ ! -x "${GO_CLI}" ]; then
  GO_CLI="${ROOT}/tools/quickreport/quickreport"
  TOOL_DIR=""
fi
if [ ! -x "${GO_CLI}" ]; then
  echo "quickreport: Go tools not built — run tools/build-go.sh" >&2
  exit 127
fi

if [ -n "${TOOL_DIR}" ]; then
  PATH="${TOOL_DIR}:${PATH}"
else
  for d in "${ROOT}/tools/"*/; do
    [ -n "${d}" ] || continue
    n="$(basename "${d}")"
    if [ -x "${d}${n}" ]; then
      PATH="${d}:${PATH}"
    fi
  done
fi
export PATH
# Generated shortcuts/services must invoke this entry point, not the
# inner Go binary directly.
export QE_LAUNCHER="${BASH_SOURCE[0]}"
exec "${GO_CLI}" "$@"
